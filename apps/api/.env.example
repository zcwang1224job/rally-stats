# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://rally:rally_dev@localhost:5432/rally_stats

# JWT signing secret for admin tokens (and, later, member auth tokens)
JWT_SECRET=change-me-to-a-long-random-string

# Cloudflare Turnstile (test keys shown here always pass/fail predictably;
# see https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# AES-256-GCM key (32 raw bytes, base64-encoded) for reversible group-password encryption
PASSWORD_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key

# Ably realtime
ABLY_API_KEY=change-me

# --- LAN access (optional) ---
# Uncomment and set to the host machine's LAN IP if other devices on the
# local network need to reach the app (e.g. http://192.168.1.50:4200).
# FRONTEND_BASE_URL is used to build links in verification/reset emails;
# CORS_ALLOWED_ORIGINS only matters if a browser calls the backend's
# published port (8000) directly instead of through the frontend's Nginx
# /api proxy. See docs/local-development.md for the full walkthrough.
# FRONTEND_BASE_URL=http://192.168.1.50:4200
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://192.168.1.50:4200
